# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# The recipient address where contact form submissions will be delivered
CONTACT_RECEIVER_EMAIL=hello@martinluzak.sk

# The sender address configured and verified in Resend (e.g. hello@martinluzak.sk or onboarding@resend.dev for initial sandbox)
CONTACT_SENDER_EMAIL=Martin Lužák <hello@martinluzak.sk>

# AI Assistant Providers (Add at least one to activate live AI responses)
# 1. Google Gemini (Recommended - free tier at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# 3. OpenAI GPT-4o (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Sentry Observability & Error Tracking (https://sentry.io/)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Umami Analytics (Self-hosted on Supabase/Vercel or Umami Cloud)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
